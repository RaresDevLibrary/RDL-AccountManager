<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RDL-AccountManager</AssemblyName>
    <Product>RDL Account Manager</Product>
    <Description>Local Roblox account and client manager</Description>
    <Version>13.0.0</Version>
    <AssemblyVersion>13.0.0.0</AssemblyVersion>
    <FileVersion>13.0.0.0</FileVersion>
    <ApplicationIcon>RDL.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <EmbeddedResource Include="RDL.ico" LogicalName="RDL.ico" />
    <EmbeddedResource Include="RDL.png" LogicalName="RDL.png" />
    <EmbeddedResource Include="Opensound.wav" LogicalName="Opensound.wav" />
    <EmbeddedResource Include="hoversound.wav" LogicalName="hoversound.wav" />
  </ItemGroup>
</Project>

